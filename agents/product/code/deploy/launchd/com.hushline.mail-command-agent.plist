<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hushline.mail-command-agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>__INSTALL_DIR__/mail_command_agent.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PRIMARY_WORKSPACE__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>CODEX_HOME</key>
    <string>__CODEX_HOME__</string>
    <key>HOME</key>
    <string>__HOME_DIR__</string>
    <key>HUSHLINE_MAIL_COMMAND_AGENT_STATE_DIR</key>
    <string>__STATE_DIR__</string>
    <key>HUSHLINE_MAIL_COMMAND_AGENT_WORKSPACE_DIRS</key>
    <string>__WORKSPACE_DIRS__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/mail-command-agent.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/mail-command-agent.stderr.log</string>
</dict>
</plist>
